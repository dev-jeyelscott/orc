# Copy to .env and adjust for your machine.

# Root directory scanned for discoverable Git repositories (direct children only).
WORKSPACE_ROOT=~/workspace

# Point at the docker-compose Postgres service, or an existing local Postgres instance.
DATABASE_URL=postgresql://orc:orc@localhost:5432/orc

SERVER_PORT=4000
NODE_ENV=development

# Maximum number of worker executions allowed in one workflow run.
MAX_WORKFLOW_EXECUTIONS=10

# Optional durable knowledge MCP integration.
# Leave KNOWLEDGE_MCP_COMMAND unset to run ORC with knowledge completely disabled.
# The standalone process owns vault containment, authority policy, protected prefixes,
# retrieval budgets, and all KNOWLEDGE_VAULT_* configuration.
# KNOWLEDGE_MCP_COMMAND=knowledge-vault-mcp
# KNOWLEDGE_VAULT_ROOT=<configured-vault-root>
# KNOWLEDGE_VAULT_PROTECTED_PREFIXES=private,secrets

# Optional server-only Notion task-source credential.
# Configure each Team's Notion Data Source ID in the ORC dashboard.
# NOTION_API_KEY=ntn_your_server_only_secret

# Optional Notion scheduler overrides.
# NOTION_API_VERSION=2026-03-11
# NOTION_POLL_INTERVAL_SECONDS=30
# NOTION_POST_APPROVAL_DELAY_SECONDS=5
