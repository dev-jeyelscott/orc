{
  "name": "@orc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint .",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.2",
    "@orc/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "node-pty": "^1.1.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}
